<span class="kn">from</span><span class="w"> </span><span class="nn">pyspark.sql.functions</span><span class="w"> </span><span class="kn">import</span> <span class="n">col</span> <span class="c1"># &lt;-- ASSUREZ-VOUS QUE CECI EST IMPORTÉ</span>

