<span class="nb">print</span><span class="p">(</span><span class="sa">f</span><span class="s2">"Environment details saved to </span><span class="si">{</span><span class="n">ENV_PATH</span><span class="o">.</span><span class="n">resolve</span><span class="p">()</span><span class="si">}</span><span class="s2">"</span><span class="p">)</span>
</pre></div>
