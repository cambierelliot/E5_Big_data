<span class="k">def</span><span class="w"> </span><span class="nf">stripe_to_rows</span><span class="p">(</span><span class="n">item</span><span class="p">):</span>
    <span class="n">x</span><span class="p">,</span> <span class="n">counter</span> <span class="o">=</span> <span class="n">item</span>
