        <span class="k">if</span> <span class="n">counter</span><span class="p">:</span>
            <span class="k">yield</span> <span class="p">(</span><span class="n">x</span><span class="p">,</span> <span class="n">counter</span><span class="p">)</span>

<span class="k">def</span><span class="w"> </span><span class="nf">merge_counters</span><span class="p">(</span><span class="n">c1</span><span class="p">,</span> <span class="n">c2</span><span class="p">):</span>
