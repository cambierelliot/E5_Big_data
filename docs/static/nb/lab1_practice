    <span class="o">.</span><span class="n">orderBy</span><span class="p">(</span><span class="n">F</span><span class="o">.</span><span class="n">desc</span><span class="p">(</span><span class="s2">"count"</span><span class="p">),</span> <span class="n">F</span><span class="o">.</span><span class="n">asc</span><span class="p">(</span><span class="s2">"token"</span><span class="p">))</span>
