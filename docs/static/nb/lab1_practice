    <span class="n">tokens_per_line</span>
    <span class="o">.</span><span class="n">flatMap</span><span class="p">(</span><span class="n">stripe_builder</span><span class="p">)</span>
    <span class="o">.</span><span class="n">reduceByKey</span><span class="p">(</span><span class="n">merge_counters</span><span class="p">))</span>

<span class="n">pmi_stripes_rdd</span> <span class="o">=</span> <span class="n">stripes_counts</span><span class="o">.</span><span class="n">flatMap</span><span class="p">(</span><span class="n">stripe_to_rows</span><span class="p">)</span>

<span class="n">stripes_df</span> <span class="o">=</span> <span class="n">spark</span><span class="o">.</span><span class="n">createDataFrame</span><span class="p">(</span><span class="n">pmi_stripes_rdd</span><span class="p">,</span> <span class="n">schema</span><span class="o">=</span><span class="p">[</span><span class="s2">"x"</span><span class="p">,</span> <span class="s2">"y"</span><span class="p">,</span> <span class="s2">"pmi"</span><span class="p">,</span> <span class="s2">"count"</span><span class="p">])</span><span class="o">.</span><span class="n">orderBy</span><span class="p">(</span><span class="n">F</span><span class="o">.</span><span class="n">desc</span><span class="p">(</span><span class="s2">"pmi"</span><span class="p">))</span>

