            <span class="n">F</span><span class="o">.</span><span class="n">regexp_replace</span><span class="p">(</span><span class="n">F</span><span class="o">.</span><span class="n">lower</span><span class="p">(</span><span class="s2">"line"</span><span class="p">),</span> <span class="s2">"[^a-z]+"</span><span class="p">,</span> <span class="s2">" "</span><span class="p">),</span>
            <span class="s2">"\s+"</span>
        <span class="p">)</span><span class="o">.</span><span class="n">alias</span><span class="p">(</span><span class="s2">"tokens"</span><span class="p">)</span>
    <span class="p">))</span>

<span class="n">wordcount_df</span> <span class="o">=</span> <span class="p">(</span>
    <span class="n">clean_tokens_df</span>
    <span class="o">.</span><span class="n">select</span><span class="p">(</span><span class="n">F</span><span class="o">.</span><span class="n">explode</span><span class="p">(</span><span class="n">F</span><span class="o">.</span><span class="n">expr</span><span class="p">(</span><span class="s2">"filter(tokens, x -&gt; x &lt;&gt; '')"</span><span class="p">))</span><span class="o">.</span><span class="n">alias</span><span class="p">(</span><span class="s2">"token"</span><span class="p">))</span>
