        <span class="p">)</span>
        
        <span class="n">trial_pred_path</span> <span class="o">=</span> <span class="n">OUTPUTS_DIR</span> <span class="o">/</span> <span class="sa">f</span><span class="s2">"shuffle_pred_</span><span class="si">{</span><span class="n">i</span><span class="si">}</span><span class="s2">"</span>
