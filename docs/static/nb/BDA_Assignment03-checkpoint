        <span class="nb">print</span><span class="p">(</span><span class="sa">f</span><span class="s2">"Deleted old output: </span><span class="si">{</span><span class="n">path</span><span class="si">}</span><span class="s2">"</span><span class="p">)</span>
</pre></div>
